# Docker Compose env-file format, read via `--env-file`. Not shell: do not
# `source` it. Values are taken literally, so leave them unquoted (quotes and
# backslashes would be interpreted and would corrupt the secrets below).
GCP_PROJECT_ID=asc-internal-tools-dev
GATEWAY_HOSTNAME=dev.drone.advancedspadecompany.com
# Filled by remote-deploy.sh from the GCE metadata server.
GATEWAY_INTERNAL_IP=

CLUSTERODM_IMAGE=us-central1-docker.pkg.dev/asc-shared-services-dev/containers/clusterodm-asc:dev
NODEODM_IMAGE=us-central1-docker.pkg.dev/asc-shared-services-dev/containers/nodeodm-asc:dev

ASR_CONFIG_PATH=/run/secrets/gcp-asr.json

# Generate independent random values:
#   openssl rand -hex 32
SESSION_SECRET=replace-me
REFERENCE_NODE_TOKEN=replace-me
CLUSTERODM_ADMIN_PASSWORD=replace-me

OAUTH_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=replace-me
# Google Workspace domain of the sign-in accounts, not the gateway hostname.
OAUTH_ALLOWED_DOMAINS=aspadeco.com
OAUTH_SESSION_DAYS=30

# Standalone portal: PORTAL_SUPER_ENV_URL is intentionally unset. Setting it
# pairs this host for cross-host sign-in, which requires both hosts to share
# SESSION_SECRET or every login fails with error=bridge_invalid.
PORTAL_STAGING_ENV_LABEL=cluster dev
PORTAL_STAGING_ENV_TAGLINE=On-demand processing
