{
    "provider": "gcp",
    "project": "asc-internal-tools-dev",
    "zone": [
        "us-central1-a",
        "us-central1-b",
        "us-central1-c",
        "us-central1-f"
    ],
    "network": "internal-tools-vpc",
    "subnetwork": "internal-tools-us-central1",
    "tags": [
        "clusterodm-worker"
    ],
    "serviceAccount": "clusterodm-worker@asc-internal-tools-dev.iam.gserviceaccount.com",
    "scopes": [
        "https://www.googleapis.com/auth/cloud-platform"
    ],
    "machineImage": "projects/cos-cloud/global/images/family/cos-stable",
    "useInternalIpOnly": true,
    "skipFirewallCreate": true,
    "preemptible": false,
    "instanceLimit": 1,
    "createRetries": 12,
    "maxRuntime": 172800,
    "maxUploadTime": 7200,
    "imageSizeMapping": [
        {
            "maxImages": 800,
            "slug": "c3-highmem-22",
            "storage": 500,
            "diskType": "pd-balanced",
            "dockerMemory": "154g",
            "fallbacks": [
                {
                    "slug": "n2-highmem-16",
                    "dockerMemory": "112g"
                },
                {
                    "slug": "n2d-highmem-16",
                    "dockerMemory": "112g"
                }
            ]
        },
        {
            "maxImages": 5000,
            "slug": "n2-highmem-32",
            "storage": 1000,
            "diskType": "pd-balanced",
            "dockerMemory": "224g",
            "fallbacks": [
                {
                    "slug": "n2d-highmem-32",
                    "dockerMemory": "224g"
                }
            ]
        }
    ],
    "gcs": {
        "enabled": true,
        "bucket": "asc-nodeodm-outputs-dev",
        "projectId": "asc-consumer-apps-dev",
        "uploadPrefix": "outputs",
        "uploadPaths": "odm_orthophoto,odm_dem,odm_report,odm_georeferencing,odm_meshing,odm_texturing,odm_texturing_25d,odm_filterpoints,3d_tiles,orthophoto_tiles,rtk_analysis,cameras.json,images.json,img_list.txt,log.json,options.json,task_output.txt,benchmark.txt",
        "cleanupAfterUpload": true
    },
    "webhookBaseUrl": "",
    "dockerImage": "us-central1-docker.pkg.dev/asc-shared-services-dev/containers/nodeodm-asc:dev",
    "dockerRegistry": {
        "url": "https://us-central1-docker.pkg.dev",
        "useInstanceCredentials": true
    }
}
